# ============================================================================
# PRODUCTION environment values (loaded when APP_ENV=prod).
# Copy this file to `.env.prod`. Use STRONG secrets and managed endpoints.
# In real production, inject these via a secrets manager, not a file.
# ============================================================================

APP_ENV=prod
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=social
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=social_support

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=mongo_root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_password
MONGO_URI=mongodb://mongo_root:CHANGE_ME_strong_password@mongodb:27017
MONGO_DB=social_support

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enablement_kb

# --- Neo4j ---
NEO4J_AUTH=neo4j/CHANGE_ME_strong_password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_strong_password

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=180
ENABLE_VISION=false
OLLAMA_VISION_MODEL=llava:7b

# --- LLM concurrency ---
LLM_MAX_CONCURRENCY=2

# --- Langfuse ---
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- ML artifacts ---
ML_ARTIFACTS_DIR=/artifacts

# --- Uploads ---
UPLOAD_DIR=/app/uploads

# --- Frontend -> backend API base URL ---
BACKEND_API_URL=http://backend:8000
