# ============================================================================
# DEVELOPMENT environment values (loaded when APP_ENV=dev).
# Copy this file to `.env.dev`. Hostnames match docker-compose service names.
# Contains secrets/credentials -> DO NOT COMMIT the real `.env.dev`.
# ============================================================================

APP_ENV=dev
LOG_LEVEL=DEBUG

# --- PostgreSQL (relational: applications, decisions, audit) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=social
POSTGRES_PASSWORD=social_dev_pw
POSTGRES_DB=social_support

# --- MongoDB (raw documents + flexible extraction JSON) ---
# MONGO_INITDB_* configure the container; MONGO_URI is what the app uses.
MONGO_INITDB_ROOT_USERNAME=mongo_root
MONGO_INITDB_ROOT_PASSWORD=mongo_dev_pw
MONGO_URI=mongodb://mongo_root:mongo_dev_pw@mongodb:27017
MONGO_DB=social_support

# --- Qdrant (vector store for enablement knowledge base / RAG) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enablement_kb

# --- Neo4j (household / relationship graph) ---
# NEO4J_AUTH configures the container; app uses NEO4J_USER/NEO4J_PASSWORD.
NEO4J_AUTH=neo4j/neo4j_dev_pw
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_pw

# --- Ollama (local LLM + embeddings) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=180
# Optional multimodal vision model (heavy on CPU; off by default)
ENABLE_VISION=false
OLLAMA_VISION_MODEL=llava:7b

# --- LLM concurrency guard (serialize calls to protect CPU-only Ollama) ---
LLM_MAX_CONCURRENCY=1

# --- Langfuse (observability). Paste your keys here. ---
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- ML artifacts (trained model directory, mounted into backend) ---
ML_ARTIFACTS_DIR=/artifacts

# --- Uploads (runtime document storage inside backend container) ---
UPLOAD_DIR=/app/uploads

# --- Frontend -> backend API base URL (service name inside compose network) ---
BACKEND_API_URL=http://backend:8000
