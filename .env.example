# ============================================================================
# COMMON .env  -- selects which environment configuration to load.
# Copy this file to `.env` and set APP_ENV to `dev` or `prod`.
# The application then loads `.env` first, then `.env.<APP_ENV>` (which
# overrides values here). OS environment variables override everything.
# ============================================================================

# Which environment to run: dev | prod
APP_ENV=dev

# Shared non-secret defaults (can be overridden in .env.dev / .env.prod)
LOG_LEVEL=INFO
